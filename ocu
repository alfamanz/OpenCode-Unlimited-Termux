#!/usr/bin/env bash
# ocu — OpenCode free-tier identity helper. Termux port of Tazmyan/OpenCode-Unlimited.
# bash + node only; no PowerShell, no Windows APIs.
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
PLUGIN_DIR="$CFG/plugin"
PLUGIN="$PLUGIN_DIR/unlimited-shield.js"
IDENTITY="$CFG/identity.json"
STATE="$CFG/unlimited.json"
CMD_DIR="$CFG/command"
BRIDGE="$ROOT/lib/proxy-bridge.js"
DB_HELPER="$ROOT/lib/ocu-db.js"
BUNDLED_PLUGIN="$ROOT/plugin/unlimited-shield.js"
LOG="$CFG/unlimited-bridge.log"
PIDFILE="$CFG/unlimited-bridge.pid"
PORT="${OCU_BRIDGE_PORT:-8899}"
DATA_DIR="$HOME/.local/share/opencode"
GATEWAY="https://opencode.ai/inference/openai/v1/chat/completions"
MODEL="${OCU_MODEL:-crouton-alpha-free}"

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_BAD=$'\033[31m'; C_DIM=$'\033[90m'; C_OFF=$'\033[0m'
else
  C_OK=; C_WARN=; C_BAD=; C_DIM=; C_OFF=
fi

ok()   { printf '  %s[+]%s %s\n' "$C_OK" "$C_OFF" "$*"; }
warn() { printf '  %s[!]%s %s\n' "$C_WARN" "$C_OFF" "$*"; }
bad()  { printf '  %s[x]%s %s\n' "$C_BAD" "$C_OFF" "$*"; }
info() { printf '      %s%s%s\n' "$C_DIM" "$*" "$C_OFF"; }
step() { printf '%s\n' "$*"; }

oc_bin() {
  command -v opencode2 2>/dev/null || command -v opencode 2>/dev/null || true
}

state_get() {
  [ -f "$STATE" ] || return 1
  node -e '
    try {
      const s = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))
      const v = s[process.argv[2]]
      if (v !== undefined && v !== null) process.stdout.write(String(v))
    } catch {}
  ' "$STATE" "$1"
}

state_set() {
  node -e '
    const fs = require("node:fs")
    const [file, key, value] = process.argv.slice(1)
    let s = {}
    try { s = JSON.parse(fs.readFileSync(file, "utf8")) } catch {}
    s[key] = value
    s.updatedAt = new Date().toISOString()
    fs.mkdirSync(require("node:path").dirname(file), { recursive: true })
    fs.writeFileSync(file, JSON.stringify(s, null, 2) + "\n")
  ' "$STATE" "$1" "$2"
}

resolve_db() {
  if [ -n "${OPENCODE_DB:-}" ] && [ -f "$OPENCODE_DB" ]; then
    printf '%s' "$OPENCODE_DB"; return
  fi
  local newest
  newest="$(ls -t "$DATA_DIR"/opencode*.db 2>/dev/null | head -1)"
  if [ -n "$newest" ]; then printf '%s' "$newest"; return; fi
  printf '%s' "$DATA_DIR/opencode.db"
}

new_identity() {
  local dir="${1:-$PWD}"
  mkdir -p "$CFG"
  node -e '
    const fs = require("node:fs")
    const { randomBytes } = require("node:crypto")
    const [file, dir] = process.argv.slice(1)
    const id = randomBytes(20).toString("hex")
    fs.writeFileSync(file, JSON.stringify({
      projectId: id,
      clientId: "cli",
      directory: dir,
      createdAt: new Date().toISOString(),
    }, null, 2) + "\n")
    process.stdout.write(id)
  ' "$IDENTITY" "$dir"
}

identity_id() {
  [ -f "$IDENTITY" ] || return 1
  node -e '
    try {
      const s = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))
      const id = String(s.projectId ?? "").toLowerCase()
      if (/^[0-9a-f]{40}$/.test(id)) process.stdout.write(id)
      else process.exit(1)
    } catch { process.exit(1) }
  ' "$IDENTITY"
}

plugin_state() {
  if [ -f "$PLUGIN" ]; then echo enabled
  elif [ -f "$PLUGIN.disabled" ]; then echo disabled
  else echo missing
  fi
}

egress_ip() {
  curl -s --max-time 8 https://cloudflare.com/cdn-cgi/trace 2>/dev/null | sed -n 's/^ip=//p' | head -1
}

proxy_ip() {
  curl -s --max-time 10 --proxy "$1" https://cloudflare.com/cdn-cgi/trace 2>/dev/null | sed -n 's/^ip=//p' | head -1
}

bridge_alive() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

stop_bridge() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    ok "bridge stopped (pid $pid)"
  fi
  rm -f "$PIDFILE"
}

start_bridge() {
  local upstream="$1"
  if bridge_alive; then
    info "bridge already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  if [ ! -f "$BRIDGE" ]; then bad "bridge missing: $BRIDGE"; return 1; fi
  nohup node "$BRIDGE" --listen "127.0.0.1:$PORT" --upstream "$upstream" --log "$LOG" >/dev/null 2>&1 &
  echo $! > "$PIDFILE"
  sleep 1
  if bridge_alive; then
    ok "bridge up on 127.0.0.1:$PORT -> $upstream"
    return 0
  fi
  bad "bridge exited, see $LOG"
  return 1
}

install_commands() {
  mkdir -p "$CMD_DIR"
  local tail_line='Answer with one short line about what the output above reported. No more.'
  printf -- '---\ndescription: OpenCode free-tier helper — identity, plugin, egress\n---\n!`ocu status`\n\n%s\n' "$tail_line" > "$CMD_DIR/ocu.md"
  printf -- '---\ndescription: probe the free bucket on this connection\n---\n!`ocu test %s`\n\n%s\n' '${ARGUMENTS}' "$tail_line" > "$CMD_DIR/ocu-test.md"
  printf -- '---\ndescription: rotate a project identity and clear stuck limit errors\n---\n!`ocu reset %s`\n\n%s\n' '${ARGUMENTS}' "$tail_line" > "$CMD_DIR/ocu-reset.md"
  printf -- '---\ndescription: rotate a project id, optional folder argument\n---\n!`ocu id %s`\n\n%s\n' '${ARGUMENTS}' "$tail_line" > "$CMD_DIR/ocu-id.md"
  ok "slash commands: $(ls "$CMD_DIR" | tr '\n' ' ')"
}

ensure_runtime() {
  case "$ROOT" in
    /sdcard/*|/storage/*|/mnt/media_rw/*)
      local dest="$HOME/.local/share/ocu"
      mkdir -p "$dest"
      cp -f "$SELF" "$dest/ocu"
      rm -rf "$dest/lib" "$dest/plugin"
      cp -r "$ROOT/lib" "$ROOT/plugin" "$dest/"
      chmod 755 "$dest/ocu"
      ROOT="$dest"
      SELF="$dest/ocu"
      ok "runtime copied to $dest (sdcard is noexec)"
      ;;
  esac
}

cmd_install() {
  step "==> installing ocu"
  ensure_runtime
  [ -f "$BUNDLED_PLUGIN" ] || { bad "bundled plugin missing: $BUNDLED_PLUGIN"; return 1; }
  mkdir -p "$PLUGIN_DIR"
  cp "$BUNDLED_PLUGIN" "$PLUGIN"
  ok "plugin deployed: $PLUGIN"

  if [ ! -f "$IDENTITY" ]; then
    new_identity "$HOME" >/dev/null
    ok "identity created: $IDENTITY"
  else
    info "identity kept: $(identity_id 2>/dev/null || echo invalid)"
  fi

  install_commands

  local target="$PREFIX/bin/ocu"
  if [ -w "$PREFIX/bin" ]; then
    if [ "$(readlink -f "$SELF")" != "$(readlink -f "$target" 2>/dev/null)" ]; then
      ln -sf "$SELF" "$target"
      ok "command linked: $target -> $SELF"
    else
      info "already linked: $target"
    fi
  else
    info "run it from $ROOT/ocu"
  fi

  step ""
  ok "done. try: ocu status"
}

cmd_id() {
  local target="" db_flag=0
  for arg in "$@"; do
    case "$arg" in
      -Db|--db) db_flag=1 ;;
      -*) ;;
      *) target="$arg" ;;
    esac
  done

  step "==> rotating project identity"
  local before; before="$(identity_id 2>/dev/null || true)"
  local next; next="$(new_identity "${target:-$PWD}")"
  ok "project id  $next"
  info "directory   ${target:-$PWD}"
  [ -n "$before" ] && info "was         $before"

  if [ -n "$target" ] || [ "$db_flag" -eq 1 ]; then
    local db; db="$(resolve_db)"
    if [ ! -f "$db" ]; then
      warn "opencode.db not found under $DATA_DIR"
    else
      node "$DB_HELPER" rotate "$db" "$target" || warn "db rotation skipped"
    fi
  else
    info "database rows untouched; pass a path or -Db to rotate them"
  fi
  state_set identityPath "$IDENTITY"
  ok "identity rotated"
}

cmd_reset() {
  local target="" db_flag=0
  for arg in "$@"; do
    case "$arg" in
      -Db|--db) db_flag=1 ;;
      -*) ;;
      *) target="$arg" ;;
    esac
  done

  step "==> full reset"
  local ip_before; ip_before="$(egress_ip)"
  info "egress ip before: ${ip_before:-unavailable}"

  step "[1/3] rotating project identity"
  cmd_id "$@" | sed 's/^/  /'

  step "[2/3] clearing stuck limit rows"
  local db; db="$(resolve_db)"
  if [ -f "$db" ]; then
    node "$DB_HELPER" clean "$db" | sed 's/^/      /'
  else
    warn "no database at $db"
  fi

  step "[3/3] egress ip after"
  sleep 1
  local ip_after; ip_after="$(egress_ip)"
  state_set lastIp "${ip_after:-unavailable}"
  if [ -n "$ip_before" ] && [ "$ip_before" = "$ip_after" ]; then
    warn "ip unchanged: ${ip_after:-unavailable} — rotate the connection (VPN/hotspot/router) for a new bucket"
  else
    ok "new egress ip: ${ip_after:-unavailable}"
  fi
  step ""
  ok "reset complete"
  info "a prompt that works is the real signal, or: ocu test -live"
}

cmd_test() {
  if [ "${1:-}" = "-live" ] || [ "${1:-}" = "--live" ]; then
    local oc; oc="$(oc_bin)"
    [ -n "$oc" ] || { bad "opencode not found on PATH"; return 1; }
    step "==> live check through the app (uses one message)"
    local out; out="$("$oc" run --auto "reply with exactly: ok" 2>&1)"
    local code=$?
    if printf '%s' "$out" | grep -qiE 'free usage limit|used today.s free messages|FreeUsageLimit'; then
      bad "EMPTY — the app itself is blocked on this connection"
      return 0
    fi
    if [ "$code" -eq 0 ] && printf '%s' "$out" | grep -qi 'ok'; then
      ok "WORKING — the app answered, keep prompting"
      return 0
    fi
    warn "could not confirm, output:"
    printf '%s\n' "$out" | grep -v '^$' | head -4 | sed 's/^/      /'
  fi

  step "==> direct api probe (free, not the app quota)"
  local id; id="$(identity_id 2>/dev/null || true)"
  if [ -z "$id" ]; then bad "no valid identity, run: ocu id"; return 1; fi
  info "project id: $id"
  info "egress ip : $(egress_ip)"
  local body; body="$(mktemp)"
  local code
  code="$(curl -s -o "$body" -w '%{http_code}' --max-time 20 -X POST "$GATEWAY" \
    -H 'content-type: application/json' \
    -H 'user-agent: opencode/2.1.4' \
    -H 'x-opencode-client: cli' \
    -H "x-opencode-project: $id" \
    --data-binary "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"1\"}],\"max_tokens\":1,\"stream\":false}")"
  case "$code" in
    200) ok "RAW 200 — the direct API accepted this request" ;;
    429) warn "RAW 429 — expected for non-app clients; does not measure the app quota" ;;
    *)   warn "RAW $code — $(head -c 200 "$body" 2>/dev/null)" ;;
  esac
  rm -f "$body"
  info "the app has its own quota; a prompt that works means you are fine"
  info "real answer: ocu test -live"
}

cmd_status() {
  step "==> ocu status"
  step ""
  step "identity"
  local id; id="$(identity_id 2>/dev/null || true)"
  if [ -n "$id" ]; then
    info "project id : $id"
    info "file       : $IDENTITY"
  else
    warn "no identity yet, run: ocu id"
  fi

  step ""
  step "plugin"
  info "state      : $(plugin_state)"
  info "path       : $PLUGIN"
  info "opencode   : $(oc_bin || echo 'not found')"

  step ""
  step "database"
  local db; db="$(resolve_db)"
  info "path       : $db"
  if [ -f "$db" ]; then
    node "$DB_HELPER" status "$db" 2>/dev/null | sed 's/^/      /'
  else
    warn "missing"
  fi

  step ""
  step "network"
  info "egress ip  : $(egress_ip)"
  local proxy; proxy="$(state_get proxy 2>/dev/null || true)"
  info "upstream   : ${proxy:-none (direct)}"
  [ -n "$proxy" ] && info "ip via proxy: $(proxy_ip "$proxy")"
  if bridge_alive; then info "bridge     : running (pid $(cat "$PIDFILE"), port $PORT)"; else info "bridge     : stopped"; fi
}

cmd_on()  { mkdir -p "$PLUGIN_DIR"; [ -f "$PLUGIN.disabled" ] && mv "$PLUGIN.disabled" "$PLUGIN"; ok "plugin enabled"; }
cmd_off() { [ -f "$PLUGIN" ] && mv "$PLUGIN" "$PLUGIN.disabled"; ok "plugin disabled"; }

cmd_proxy() {
  local sub="${1:-status}"
  case "$sub" in
    off)
      stop_bridge
      state_set proxy ""
      ok "egress is direct again"
      ;;
    status)
      local via; via="$(state_get proxy 2>/dev/null || true)"
      info "upstream : ${via:-none}"
      info "bridge   : 127.0.0.1:$PORT"
      info "ip       : $(egress_ip)"
      [ -n "$via" ] && info "ip proxy : $(proxy_ip "$via")"
      ;;
    set)
      local url="${2:-}"
      if [ -z "$url" ]; then bad "usage: ocu proxy set socks5://host:port"; return 1; fi
      case "$url" in
        socks5://*|socks5h://*|http://*) ;;
        *) bad "expected socks5://host:port or http://host:port"; return 1 ;;
      esac
      if ! curl -s --max-time 12 --proxy "$url" https://cloudflare.com/cdn-cgi/trace 2>/dev/null | grep -q '^ip='; then
        bad "upstream not answering: $url"
        info "cek host:port, tipe proxy (http vs socks5), dan kredensial"
        state_set proxy ""
        return 1
      fi
      state_set proxy "$url"
      start_bridge "$url" || { state_set proxy ""; return 1; }
      ok "proxy set; run opencode through it with: ocu run"
      ;;
    *)
      bad "usage: ocu proxy set <url> | off | status"
      ;;
  esac
}

cmd_run() {
  local proxy; proxy="$(state_get proxy 2>/dev/null || true)"
  local oc; oc="$(oc_bin)"
  [ -n "$oc" ] || { bad "opencode not found on PATH"; return 1; }
  if [ -n "$proxy" ]; then
    if ! bridge_alive; then start_bridge "$proxy" || return 1; fi
    export HTTPS_PROXY="http://127.0.0.1:$PORT"
    export HTTP_PROXY="http://127.0.0.1:$PORT"
    export ALL_PROXY="http://127.0.0.1:$PORT"
    export NO_PROXY="localhost,127.0.0.1"
    info "routing through 127.0.0.1:$PORT -> $proxy"
  fi
  exec "$oc" "$@"
}

cmd_doctor() {
  step "==> ocu doctor"
  step ""
  info "platform   : $(uname -m) / $([ -n "${TERMUX_VERSION:-}" ] && echo termux || echo unix)"
  info "bash       : ${BASH_VERSION}"
  if command -v node >/dev/null 2>&1; then
    ok "node       : $(node --version)"
    node -e 'require("node:sqlite")' 2>/dev/null && ok "sqlite     : node:sqlite available" || warn "sqlite     : node:sqlite missing (needs node 22.5+)"
  else
    warn "node       : not found (bridge and db rotation need it)"
  fi
  command -v curl >/dev/null 2>&1 && ok "curl       : found" || warn "curl       : missing"
  info "opencode   : $(oc_bin || echo 'not found')"
  info "plugin     : $(plugin_state) — $PLUGIN"
  local id; id="$(identity_id 2>/dev/null || true)"
  [ -n "$id" ] && ok "identity   : $id" || warn "identity   : missing or invalid, run: ocu id"
  info "upstream   : $(state_get proxy 2>/dev/null || echo none)"
  info "egress ip  : $(egress_ip)"
}

cmd_uninstall() {
  step "==> uninstalling ocu"
  stop_bridge
  rm -f "$PLUGIN" "$PLUGIN.disabled"
  ok "plugin removed"
  rm -f "$CMD_DIR"/ocu.md "$CMD_DIR"/ocu-test.md "$CMD_DIR"/ocu-reset.md "$CMD_DIR"/ocu-id.md
  ok "slash commands removed"
  rm -f "$STATE" "$PIDFILE" "$LOG"
  ok "state files removed"
  info "identity.json kept (delete manually if you want a fresh one)"
}

cmd_rotate() {
  local tries=4
  for arg in "$@"; do
    case "$arg" in
      [0-9]*) tries="$arg" ;;
      *) bad "usage: ocu rotate [tries]"; return 2 ;;
    esac
  done

  command -v su >/dev/null 2>&1 || { bad "su tidak ada — pakai UI manual, lihat: ocu help"; return 1; }

  local before; before="$(egress_ip)"
  step "==> rotate koneksi (airplane mode, max $tries percobaan)"
  info "ip awal: ${before:-unavailable}"

  local i after
  for i in $(seq 1 "$tries"); do
    step "[$i/$tries] airplane mode on/off"
    su -c 'cmd connectivity airplane-mode enable' 2>/dev/null
    sleep 3
    su -c 'cmd connectivity airplane-mode disable' 2>/dev/null
    sleep 5
    after="$(egress_ip)"
    info "ip: ${after:-unavailable}"
    if [ -n "$after" ] && [ "$after" != "$before" ]; then
      state_set lastIp "$after"
      ok "ip berubah: $before -> $after"
      info "lanjut: ocu reset"
      return 0
    fi
  done

  warn "ip tidak berubah setelah $tries percobaan (${before:-unavailable})"
  info "CGNAT sering kasih ip sama berjam-jam. Coba VPN atau pindah jalur manual"
  return 1
}

cmd_help() {
  cat <<EOF
ocu <command>

  install              deploy plugin, slash commands, identity
  status               identity, plugin, database, network
  id [path] [-Db]      rotate the header id, or one project by folder
  reset [path] [-Db]   rotate a project, clear stuck limit errors
  test [-live]         direct probe (free) or a real app check (costs 1 message)
  on | off             enable or disable the identity plugin
  proxy set <url>      socks5:// or http:// upstream, via local bridge
  proxy off            drop the upstream, direct egress
  proxy status         show the current upstream
  rotate [n]           toggle airplane mode sampai ip berubah
  run <args...>        run opencode through the configured proxy
  doctor               check node, sqlite, plugin, identity
  uninstall            remove plugin, slash commands, state

env: OPENCODE_DB, OCU_MODEL, OCU_BRIDGE_PORT
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    install) cmd_install "$@" ;;
    id) cmd_id "$@" ;;
    reset) cmd_reset "$@" ;;
    test) cmd_test "$@" ;;
    status) cmd_status ;;
    on) cmd_on ;;
    off) cmd_off ;;
    proxy) cmd_proxy "$@" ;;
    rotate) cmd_rotate "$@" ;;
    run) cmd_run "$@" ;;
    doctor) cmd_doctor ;;
    uninstall) cmd_uninstall ;;
    help|-h|--help) cmd_help ;;
    *) bad "unknown command: $cmd"; cmd_help; exit 2 ;;
  esac
}

main "$@"
